# 腾讯频道（QQ 频道）访问 Cookie。
# 获取方式：先在本地运行 `nwafu-export-cookies --out cookies.json`，
# 再把 cookies.json 中 cookie_header 的值填到这里，或设置 NWAFU_COOKIE_FILE 指向该文件。
PDQQ_COOKIES=

# 可选：cookie 文件路径（与 PDQQ_COOKIES 二选一，优先 PDQQ_COOKIES）
NWAFU_COOKIE_FILE=

# 可选：频道与子版块（默认即西北农林科技大学官方频道的帖子广场）
PDQQ_GUILD_ID=inwafu1934
PDQQ_CHANNEL_ID=670126629

# 可选：频道抓取请求间隔（秒），调大更稳妥
PDQQ_MIN_DELAY=0.3
PDQQ_MAX_DELAY=0.8

# 可选：单请求超时（秒）
NWAFU_TIMEOUT=30

# ---- MCP 服务器自身（托管模式）----
# 传输方式：stdio（本地）或 streamable-http（远程托管）
NWAFU_MCP_TRANSPORT=stdio
# HTTP 监听地址与端口（托管模式）
NWAFU_MCP_HOST=0.0.0.0
NWAFU_MCP_PORT=8000
# MCP 端点路径
NWAFU_MCP_MOUNT_PATH=/mcp
# Bearer 鉴权令牌（托管模式强烈建议设置；留空=不鉴权）
NWAFU_MCP_AUTH_TOKEN=
# 无状态模式（Serverless 部署建议开启）
NWAFU_MCP_STATELESS=false
